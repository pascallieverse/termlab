{
    "name": "Termlab Server",
    "short_name": "Termlab",
    "description": "Your Termlab sessions, from any browser or phone.",
    "start_url": "/remote",
    "scope": "/",
    "display": "standalone",
    "background_color": "#0B0D11",
    "theme_color": "#0B0D11",
    "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
    ]
}
