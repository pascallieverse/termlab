# Used by the release workflow: packages the binaries it already built (static, musl).
# Expects bin/termlab-server-amd64, bin/termlab-server-arm64 and an empty bin/data/.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
COPY --chmod=0755 bin/termlab-server-${TARGETARCH} /termlab-server
COPY --chown=65532:65532 bin/data /data
ENV TERMLAB_LISTEN=0.0.0.0:8484 \
    TERMLAB_DATA_DIR=/data
VOLUME /data
EXPOSE 8484
USER nonroot
ENTRYPOINT ["/termlab-server"]
CMD ["serve"]
